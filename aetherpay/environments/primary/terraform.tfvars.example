# =============================================================================
# Primary Environment — Example Variable Values
# =============================================================================
# Copy this file to terraform.tfvars and fill in real values.
# Do NOT commit terraform.tfvars to source control if it contains secrets.
# =============================================================================

aws_region   = "us-east-1"
project_name = "aetherpay"
environment  = "primary"

# Networking
vpc_cidr                 = "10.24.0.0/20"
public_subnet_cidrs      = ["10.24.0.0/24", "10.24.1.0/24", "10.24.2.0/24"]
private_app_subnet_cidrs = ["10.24.4.0/24", "10.24.5.0/24", "10.24.6.0/24"]
isolated_db_subnet_cidrs = ["10.24.8.0/24", "10.24.9.0/24", "10.24.10.0/24"]

# ECS — replace the image URI with your actual ECR image after pushing
container_image_uri = "123456789012.dkr.ecr.us-east-1.amazonaws.com/aetherpay:latest"
ecs_task_cpu        = 512
ecs_task_memory     = 1024
ecs_desired_count   = 3
ecs_min_count       = 2
ecs_max_count       = 10

# ALB — replace with your real ACM certificate ARN after validation
acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/REPLACE-WITH-REAL-CERT-ARN"

# Aurora
aurora_master_username = "aetherpay_admin"
aurora_instance_class  = "db.r6g.large"

# Autoscaling thresholds
cpu_scale_out_threshold    = 70
memory_scale_out_threshold = 80
sqs_scale_out_threshold    = 100
